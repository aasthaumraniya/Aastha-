class Person {
  String name;

  Person(this.name);

  void display() {
    print("Person Name: $name");
  }
}

class Teacher extends Person {
  String subject;

  Teacher(String name, this.subject) : super(name);

  @override
  void display() {
    print("Teacher Name: $name");
    print("Favourite Subject: $subject");
  }
}

void main() {
  Teacher teacher = Teacher("Aastha", "Computer Science");
  teacher.display();
}
